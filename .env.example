# RoomLine environment variables.
#
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore public. Everything else is server-only and must never be prefixed
# with NEXT_PUBLIC_.

# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable (anon) key. Safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# Bypasses RLS. Server-only — never expose, never log.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Root domain used to build hotel booking URLs. No scheme, no trailing slash.
NEXT_PUBLIC_BASE_DOMAIN="localhost:3000"

# ─────────────────────────────────────────────────────────────
# Clerk (staff + platform auth)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxx"
# Svix signing secret for the Clerk user/org webhook.
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ─────────────────────────────────────────────────────────────
# Paystack (online payments)
# ─────────────────────────────────────────────────────────────
# Also the HMAC-SHA512 key used to verify webhook signatures.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_ADDRESS="RoomLine <bookings@your-domain.com>"

# ─────────────────────────────────────────────────────────────
# Upstash Redis (rate limiting)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Web Push (staff notifications)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxx"
# Shared secret authenticating this app to the deliver-push-notifications
# Supabase Edge Function. Must match the function's own PUSH_WORKER_SECRET.
PUSH_WORKER_SECRET="xxxxxxxxxxxxxxxxxxxxxx"
# The VAPID *private* key is not a Next.js variable. It is a Supabase Edge
# Function secret (VAPID_PRIVATE_KEY / VAPID_SUBJECT), set with
# `supabase secrets set`, and must never be added here.

# ─────────────────────────────────────────────────────────────
# Sentry (error monitoring)
# ─────────────────────────────────────────────────────────────
# Both DSNs are the same value from Settings > Projects > roomline > Client Keys.
# A DSN is a write-only ingest endpoint and is safe to expose in the browser.
# Two variables because the client bundle can only read NEXT_PUBLIC_* names.
# Leave both unset to make the SDK a silent no-op (useful for local dev and CI).
NEXT_PUBLIC_SENTRY_DSN="https://<key>@<orgId>.ingest.us.sentry.io/<projectId>"
SENTRY_DSN="https://<key>@<orgId>.ingest.us.sentry.io/<projectId>"

# Build-time only: uploads source maps so production stack traces are readable.
# Create at Settings > Auth Tokens with scopes project:releases + org:read.
# Never commit, and set it in the Vercel project env, not in .env.local.
SENTRY_AUTH_TOKEN=""

# Optional. Overrides the environment label on events. Defaults to VERCEL_ENV,
# then NODE_ENV, so leave unset unless you need a custom name.
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"

# Optional. Fraction (0..1) of errored browser sessions that get a Session
# Replay. Defaults to 1 — every errored session — so replays exist when they
# are needed. Lower it to shed replay quota during an incident without a deploy.
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_RATE="0.25"

# Optional. Set to "true" to attach local variables to server stack traces.
# Off by default: local scopes on this codebase hold guest names, emails and
# Paystack payloads, so only turn it on deliberately while debugging.
# SENTRY_INCLUDE_LOCAL_VARIABLES="true"
