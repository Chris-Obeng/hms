"use client";

import { useState, useEffect, FormEvent } from "react";
import { useOrganizationList, useAuth, useUser } from "@clerk/nextjs";
import { useRouter } from "next/navigation";
import { motion, AnimatePresence } from "framer-motion";
import { AsYouType } from "libphonenumber-js";
import { ArrowRight, ArrowLeft, Loader2, CheckCircle, AlertCircle } from "lucide-react";

import { createHotelProfile, type OnboardingInput as OnboardingInputType } from "@/app/actions/onboarding";
import { StepIndicator } from "./_components/step-indicator";
import { OnboardingInput as OBInput } from "./_components/onboarding-input";
import { OnboardingSelect as OBSelect } from "./_components/onboarding-select";
import { RoomStepper } from "./_components/room-stepper";
import "./onboarding.css";


// Constants

const STORAGE_KEY = "RoomLine_onboarding_data";

const HOTEL_TYPE_OPTIONS = [
  { value: "Hotel", label: "Hotel" },
  { value: "Guesthouse", label: "Guesthouse" },
  { value: "Motel", label: "Motel" },
  { value: "Serviced Apartment", label: "Serviced Apartment" },
  { value: "Lodge", label: "Lodge" },
  { value: "Boutique Hotel", label: "Boutique Hotel" },
  { value: "Resort", label: "Resort" },
];

const STAR_RATING_OPTIONS = [
  { value: "Unrated", label: "Unrated" },
  { value: "1", label: "★ 1 Star" },
  { value: "2", label: "★★ 2 Stars" },
  { value: "3", label: "★★★ 3 Stars" },
  { value: "4", label: "★★★★ 4 Stars" },
  { value: "5", label: "★★★★★ 5 Stars" },
];

const COUNTRY_OPTIONS = [
  { value: "Ghana", label: "Ghana" },
  { value: "Nigeria", label: "Nigeria" },
  { value: "Kenya", label: "Kenya" },
  { value: "South Africa", label: "South Africa" },
  { value: "Tanzania", label: "Tanzania" },
  { value: "Uganda", label: "Uganda" },
  { value: "Rwanda", label: "Rwanda" },
  { value: "Ethiopia", label: "Ethiopia" },
  { value: "Senegal", label: "Senegal" },
  { value: "Côte d'Ivoire", label: "Côte d'Ivoire" },
  { value: "Cameroon", label: "Cameroon" },
  { value: "Zambia", label: "Zambia" },
  { value: "Zimbabwe", label: "Zimbabwe" },
  { value: "Botswana", label: "Botswana" },
  { value: "Namibia", label: "Namibia" },
  { value: "Mauritius", label: "Mauritius" },
  { value: "United Kingdom", label: "United Kingdom" },
  { value: "United States", label: "United States" },
  { value: "Canada", label: "Canada" },
  { value: "Germany", label: "Germany" },
  { value: "France", label: "France" },
  { value: "Netherlands", label: "Netherlands" },
  { value: "United Arab Emirates", label: "United Arab Emirates" },
  { value: "India", label: "India" },
  { value: "China", label: "China" },
  { value: "Australia", label: "Australia" },
  { value: "New Zealand", label: "New Zealand" },
  { value: "Other", label: "Other" },
];

const COUNTRY_TO_REGION: Record<string, string> = {
  Ghana: "GH", Nigeria: "NG", Kenya: "KE", "South Africa": "ZA",
  Tanzania: "TZ", Uganda: "UG", Rwanda: "RW", Ethiopia: "ET",
  Senegal: "SN", "Côte d'Ivoire": "CI", Cameroon: "CM", Zambia: "ZM",
  Zimbabwe: "ZW", Botswana: "BW", Namibia: "NA", Mauritius: "MU",
  "United Kingdom": "GB", "United States": "US", Canada: "CA",
  Germany: "DE", France: "FR", Netherlands: "NL",
  "United Arab Emirates": "AE", India: "IN", China: "CN",
  Australia: "AU", "New Zealand": "NZ",
};

// ─── Motion variants ─────────────────────────────────────────────────────────────

const slideVariants = {
  initial: (dir: number) => ({ opacity: 0, x: dir * 24, filter: "blur(4px)" }),
  animate: { opacity: 1, x: 0, filter: "blur(0px)" },
  exit: (dir: number) => ({ opacity: 0, x: dir * -24, filter: "blur(4px)" }),
};

const TRANSITION = { duration: 0.32, ease: [0.32, 0.72, 0, 1] as const };

// ─── Step metadata ────────────────────────────────────────────────────────────

const STEP_META = [
  {
    label: "Property Details",
    description: "Tell us about your property and what makes it unique.",
  },
  {
    label: "Location & Contact",
    description: "Help guests find you and get in touch.",
  },
  {
    label: "Review & Launch",
    description: "Confirm your details and create your profile.",
  },
];

// ─── Loading skeleton ──────────────────────────────────────────────────────────

function LoadingSkeleton() {
  return (
    <div className="onboarding-container" style={{ alignItems: "center", justifyContent: "center" }}>
      <div className="flex flex-col items-center gap-3">
        <div className="w-8 h-8 rounded-full border-2 animate-spin" style={{ borderColor: "var(--onboarding-accent)", borderTopColor: "transparent" }} />
        <p className="text-[13px]" style={{ color: "var(--onboarding-text-muted)" }}>Loading…</p>
      </div>
    </div>
  );
}

// ─── Page ──────────────────────────────────────────────────────────────────────

export default function OnboardingPage() {
  const { isLoaded, setActive, createOrganization, userMemberships } =
    useOrganizationList({ userMemberships: true });
  const { orgId } = useAuth();
  const { user } = useUser();
  const router = useRouter();

  const [step, setStep] = useState(1);
  const [direction, setDirection] = useState(1);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [formData, setFormData] = useState<Partial<OnboardingInputType>>({
    country: "Ghana",
    number_of_rooms: 10,
    star_rating: "Unrated",
    hotel_type: "Hotel",
  });

  useEffect(() => {
    if (user?.primaryEmailAddress?.emailAddress && !formData.email) {
      setFormData((p) => ({ ...p, email: user.primaryEmailAddress!.emailAddress }));
    }
  }, [user, formData.email]);

  useEffect(() => {
    if (isLoaded && orgId) router.push("/dashboard");
  }, [isLoaded, orgId, router]);

  useEffect(() => {
    if (isLoaded && !orgId && userMemberships?.data?.length && setActive) {
      setActive({ organization: userMemberships.data[0].organization.id });
    }
  }, [isLoaded, orgId, userMemberships, setActive]);

  useEffect(() => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.step) setStep(parsed.step);
        if (parsed.data) setFormData((p) => ({ ...p, ...parsed.data }));
      } catch { /* ignore */ }
    }
  }, []);

  const save = (s: number, d: Partial<OnboardingInputType>) =>
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ step: s, data: d }));

  const goNext = (e: FormEvent) => {
    e.preventDefault();
    const n = step + 1;
    setDirection(1);
    setStep(n);
    save(n, formData);
  };

  const goBack = () => {
    const n = step - 1;
    setDirection(-1);
    setStep(n);
    save(n, formData);
  };

  const handlePhoneChange = (raw: string) => {
    const region = COUNTRY_TO_REGION[formData.country ?? "Ghana"] ?? "GH";
    const formatter = new AsYouType(region as any);
    setFormData((p) => ({ ...p, phone: formatter.input(raw) }));
  };

  const handleSubmit = async (e: FormEvent) => {
    e.preventDefault();
    if (!createOrganization || !setActive) return;
    setLoading(true);
    setError(null);
    try {
      const org = await createOrganization({ name: formData.name! });
      const payload: OnboardingInputType = {
        name: formData.name!,
        clerk_org_id: org.id,
        address: formData.address!,
        city: formData.city!,
        country: formData.country || "Ghana",
        phone: formData.phone!,
        email: formData.email!,
        hotel_type: formData.hotel_type || "Hotel",
        number_of_rooms: Number(formData.number_of_rooms),
        star_rating: formData.star_rating,
        website: formData.website,
      };
      const result = await createHotelProfile(payload);
      if (result?.error) throw new Error(result.error);
      await setActive({ organization: org.id });
      localStorage.removeItem(STORAGE_KEY);
      router.push("/dashboard");
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  if (!isLoaded) return <LoadingSkeleton />;

  return (
    <div className="onboarding-container">
      {/* Skip link for accessibility */}
      <a href="#main-content" className="visually-hidden">
        Skip to main content
      </a>

      {/* ── LEFT PANEL ───────────────────────────────────────────────────────── */}
      <aside
        className="hidden lg:flex lg:w-[42%] xl:w-[38%] flex-col justify-between p-10 xl:p-14 relative overflow-hidden"
        style={{ backgroundColor: "#0f172a" }}
      >
        {/* Subtle grid texture */}
        <div
          className="absolute inset-0 pointer-events-none opacity-[0.035]"
          style={{
            backgroundImage: `
              linear-gradient(rgba(255,255,255,0.8) 1px, transparent 1px),
              linear-gradient(90deg, rgba(255,255,255,0.8) 1px, transparent 1px)
            `,
            backgroundSize: "48px 48px",
          }}
        />

        {/* Top: logo */}
        <div>
          <div className="flex items-center gap-2.5 mb-16">
            {/* Logo mark */}
            <div
              className="flex items-center justify-center w-8 h-8 rounded-lg"
              style={{ backgroundColor: "rgba(255,255,255,0.1)" }}
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <rect x="1" y="7" width="6" height="8" rx="0.5" fill="white" fillOpacity="0.9" />
                <rect x="9" y="4" width="6" height="11" rx="0.5" fill="white" fillOpacity="0.6" />
                <rect x="3" y="1" width="10" height="1" rx="0.5" fill="white" fillOpacity="0.4" />
              </svg>
            </div>
            <span className="text-[15px] font-semibold text-white tracking-[-0.01em]">RoomLine</span>
          </div>

          {/* Step-aware headline */}
          <AnimatePresence mode="wait">
            <motion.div
              key={step}
              initial={{ opacity: 0, y: 12 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -8 }}
              transition={{ duration: 0.35, ease: [0.32, 0.72, 0, 1] }}
            >
              <p className="text-[12px] font-medium mb-2 uppercase tracking-[0.12em]" style={{ color: "#64748b" }}>
                Step {step} of 3
              </p>
              <h1
                className="text-[28px] xl:text-[32px] font-bold leading-tight mb-2 tracking-[-0.02em]"
                style={{ color: "#fff" }}
              >
                {stepMeta[step - 1].label}
              </h1>
              <p className="text-[14px] leading-relaxed" style={{ color: "#64748b" }}>
                {stepMeta[step - 1].sub}
              </p>
            </motion.div>
          </AnimatePresence>

          {/* Divider */}
          <div className="mt-10 mb-10 h-px" style={{ backgroundColor: "rgba(255,255,255,0.06)" }} />

          {/* Feature list */}
          <div className="flex flex-col gap-6">
            {FEATURES.map(({ icon: Icon, title, desc }, i) => (
              <motion.div
                key={title}
                initial={{ opacity: 0, x: -8 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.08 * i + 0.1, duration: 0.4 }}
                className="flex gap-3.5"
              >
                <div
                  className="flex items-center justify-center w-8 h-8 rounded-lg shrink-0 mt-0.5"
                  style={{ backgroundColor: "rgba(255,255,255,0.05)", border: "1px solid rgba(255,255,255,0.08)" }}
                >
                  <Icon size={14} strokeWidth={1.5} style={{ color: "#94a3b8" }} />
                </div>
                <div>
                  <p className="text-[13px] font-medium mb-0.5" style={{ color: "#e2e8f0" }}>{title}</p>
                  <p className="text-[12px] leading-relaxed" style={{ color: "#475569" }}>{desc}</p>
                </div>
              </motion.div>
            ))}
          </div>
        </div>

        {/* Bottom: testimonial */}
        <div
          className="mt-12 rounded-xl p-5"
          style={{ backgroundColor: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.07)" }}
        >
          <div className="flex gap-1 mb-3">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg key={i} width="12" height="12" viewBox="0 0 12 12" fill="#f59e0b">
                <path d="M6 1l1.4 2.9L10.5 4 8.25 6.2l.53 3.1L6 7.75 3.22 9.3l.53-3.1L1.5 4l3.1-.1L6 1z" />
              </svg>
            ))}
          </div>
          <p className="text-[13px] leading-relaxed mb-3 italic" style={{ color: "#94a3b8" }}>
            "{TESTIMONIAL.quote}"
          </p>
          <div>
            <p className="text-[12px] font-semibold" style={{ color: "#e2e8f0" }}>{TESTIMONIAL.author}</p>
            <p className="text-[11px]" style={{ color: "#475569" }}>{TESTIMONIAL.role}</p>
          </div>
        </div>
      </aside>

      {/* ── RIGHT PANEL ──────────────────────────────────────────────────────── */}
      <main
        className="flex-1 flex flex-col"
        style={{ backgroundColor: "#fafafa" }}
      >
        {/* Mobile header */}
        <div
          className="lg:hidden flex items-center gap-2.5 px-5 py-4 border-b"
          style={{ backgroundColor: "#fff", borderColor: "#e5e7eb" }}
        >
          <div
            className="flex items-center justify-center w-7 h-7 rounded-lg"
            style={{ backgroundColor: "#0f172a" }}
          >
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="7" width="6" height="8" rx="0.5" fill="white" fillOpacity="0.9" />
              <rect x="9" y="4" width="6" height="11" rx="0.5" fill="white" fillOpacity="0.6" />
            </svg>
          </div>
          <span className="text-[14px] font-semibold" style={{ color: "#0f172a" }}>RoomLine</span>
        </div>

        {/* Step indicator bar */}
        <div
          className="px-6 sm:px-10 py-5 border-b bg-white"
          style={{ borderColor: "#e5e7eb" }}
        >
          <StepIndicator currentStep={step} totalSteps={3} />
        </div>

        {/* Scrollable form area */}
        <div className="flex-1 flex items-start justify-center px-5 sm:px-10 py-8 overflow-y-auto">
          <div className="w-full max-w-[520px]">

            {/* Error banner */}
            <AnimatePresence>
              {error && (
                <motion.div
                  initial={{ opacity: 0, y: -8 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -8 }}
                  transition={TRANSITION}
                  className="mb-6 flex items-start gap-3 rounded-lg px-4 py-3 border"
                  style={{ backgroundColor: "#fef2f2", borderColor: "#fecaca" }}
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style={{ color: "#ef4444", flexShrink: 0, marginTop: 2 }}>
                    <circle cx="8" cy="8" r="7" stroke="currentColor" strokeWidth="1.5" />
                    <path d="M8 5v3.5M8 11h.01" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" />
                  </svg>
                  <p className="text-[13px] leading-snug" style={{ color: "#b91c1c" }}>{error}</p>
                </motion.div>
              )}
            </AnimatePresence>

            {/* Step content */}
            <div className="overflow-hidden">
              <AnimatePresence mode="wait" custom={direction} initial={false}>

                {/* ── Step 1: Property Identity ──────────────────────────── */}
                {step === 1 && (
                  <motion.div
                    key="step-1"
                    custom={direction}
                    variants={slideVariants}
                    initial="initial"
                    animate="animate"
                    exit="exit"
                    transition={TRANSITION}
                  >
                    <SectionHeader
                      eyebrow="Step 1 of 3"
                      title="Tell us about your property"
                      subtitle="This becomes your profile on RoomLine and is visible to your team."
                    />

                    <form onSubmit={goNext} className="flex flex-col gap-5">
                      <OBInput
                        label="Property Name"
                        required
                        autoFocus
                        placeholder="e.g. The Grand Harbour Hotel"
                        value={formData.name ?? ""}
                        onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                      />

                      <div className="grid grid-cols-2 gap-4">
                        <OBSelect
                          label="Property Type"
                          required
                          options={HOTEL_TYPE_OPTIONS}
                          value={formData.hotel_type ?? "Hotel"}
                          onChange={(e) => setFormData({ ...formData, hotel_type: e.target.value })}
                        />
                        <OBSelect
                          label="Star Rating"
                          options={STAR_RATING_OPTIONS}
                          hint="Optional"
                          value={formData.star_rating ?? "Unrated"}
                          onChange={(e) => setFormData({ ...formData, star_rating: e.target.value })}
                        />
                      </div>

                      <RoomStepper
                        label="Total Rooms"
                        value={formData.number_of_rooms ?? 10}
                        onChange={(val) => setFormData({ ...formData, number_of_rooms: val })}
                        hint="Count all room types including suites"
                      />

                      <div className="pt-2">
                        <PrimaryButton label="Continue" />
                      </div>
                    </form>
                  </motion.div>
                )}

                {/* ── Step 2: Location & Contact ──────────────────────────── */}
                {step === 2 && (
                  <motion.div
                    key="step-2"
                    custom={direction}
                    variants={slideVariants}
                    initial="initial"
                    animate="animate"
                    exit="exit"
                    transition={TRANSITION}
                  >
                    <SectionHeader
                      eyebrow="Step 2 of 3"
                      title="Location & contact"
                      subtitle="Guests use this to find and reach you. Keep it accurate."
                    />

                    <form onSubmit={goNext} className="flex flex-col gap-5">
                      <OBInput
                        label="Street Address"
                        required
                        autoFocus
                        placeholder="e.g. 14 Independence Avenue"
                        value={formData.address ?? ""}
                        onChange={(e) => setFormData({ ...formData, address: e.target.value })}
                      />

                      <div className="grid grid-cols-2 gap-4">
                        <OBInput
                          label="City"
                          required
                          placeholder="e.g. Accra"
                          value={formData.city ?? ""}
                          onChange={(e) => setFormData({ ...formData, city: e.target.value })}
                        />
                        <OBSelect
                          label="Country"
                          required
                          options={COUNTRY_OPTIONS}
                          value={formData.country ?? "Ghana"}
                          onChange={(e) => setFormData({ ...formData, country: e.target.value, phone: "" })}
                        />
                      </div>

                      <div className="grid grid-cols-2 gap-4">
                        <OBInput
                          label="Phone Number"
                          required
                          type="tel"
                          placeholder="e.g. 030 200 0000"
                          value={formData.phone ?? ""}
                          onChange={(e) => handlePhoneChange(e.target.value)}
                          hint="Auto-formatted"
                        />
                        <OBInput
                          label="Email Address"
                          required
                          type="email"
                          placeholder="info@yourhotel.com"
                          value={formData.email ?? ""}
                          onChange={(e) => setFormData({ ...formData, email: e.target.value })}
                        />
                      </div>

                      <OBInput
                        label="Website"
                        type="url"
                        placeholder="https://yourhotel.com"
                        value={formData.website ?? ""}
                        onChange={(e) => setFormData({ ...formData, website: e.target.value })}
                        hint="Optional"
                      />

                      <div className="flex gap-3 pt-2">
                        <BackButton onClick={goBack} />
                        <PrimaryButton label="Review & Confirm" />
                      </div>
                    </form>
                  </motion.div>
                )}

                {/* ── Step 3: Review & Launch ────────────────────────────── */}
                {step === 3 && (
                  <motion.div
                    key="step-3"
                    custom={direction}
                    variants={slideVariants}
                    initial="initial"
                    animate="animate"
                    exit="exit"
                    transition={TRANSITION}
                  >
                    <SectionHeader
                      eyebrow="Step 3 of 3 — Almost there"
                      title="Review your details"
                      subtitle="Everything looks good? Create your property profile."
                    />

                    <form onSubmit={handleSubmit} className="flex flex-col gap-6">
                      {/* Summary card */}
                      <div
                        className="rounded-xl border divide-y overflow-hidden"
                        style={{ borderColor: "#e5e7eb", backgroundColor: "#fff" }}
                      >
                        <SummaryRow icon="🏨" label="Property" value={`${formData.name}`} sub={`${formData.hotel_type} · ${formData.star_rating !== "Unrated" ? `${formData.star_rating}★` : "Unrated"} · ${formData.number_of_rooms} rooms`} />
                        <SummaryRow icon="📍" label="Location" value={`${formData.address}`} sub={`${formData.city}, ${formData.country}`} />
                        <SummaryRow icon="📞" label="Contact" value={formData.phone ?? "—"} sub={formData.email ?? "—"} />
                        {formData.website && <SummaryRow icon="🌐" label="Website" value={formData.website} />}
                      </div>

                      {/* Terms notice */}
                      <p className="text-[12px] text-center" style={{ color: "#9ca3af" }}>
                        By creating your profile you agree to our{" "}
                        <a href="#" className="underline underline-offset-2 hover:text-gray-600 transition-colors">Terms</a>
                        {" "}and{" "}
                        <a href="#" className="underline underline-offset-2 hover:text-gray-600 transition-colors">Privacy Policy</a>.
                      </p>

                      <div className="flex gap-3">
                        <BackButton onClick={goBack} disabled={loading} />
                        <button
                          type="submit"
                          disabled={loading}
                          className="flex-1 flex items-center justify-center gap-2 h-11 rounded-lg font-semibold text-[14px] text-white transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed active:scale-[0.99]"
                          style={{ backgroundColor: "#0f172a" }}
                          onMouseEnter={(e) => { if (!loading) (e.currentTarget as HTMLElement).style.backgroundColor = "#1e293b"; }}
                          onMouseLeave={(e) => { (e.currentTarget as HTMLElement).style.backgroundColor = "#0f172a"; }}
                        >
                          {loading ? (
                            <>
                              <Loader2 size={15} strokeWidth={2} className="animate-spin" />
                              Setting up your property…
                            </>
                          ) : (
                            <>
                              <CheckCircle size={15} strokeWidth={2} />
                              Create Property Profile
                            </>
                          )}
                        </button>
                      </div>
                    </form>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          </div>
        </div>

        {/* Footer */}
        <div className="px-6 py-4 flex items-center justify-between border-t" style={{ borderColor: "#e5e7eb", backgroundColor: "#fff" }}>
          <p className="text-[11px]" style={{ color: "#9ca3af" }}>
            © 2026 RoomLine
          </p>
          <div className="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 1a5 5 0 100 10A5 5 0 006 1zM4 6l1.5 1.5L8 4" stroke="#16a34a" strokeWidth="1.3" strokeLinecap="round" strokeLinejoin="round" />
            </svg>
            <p className="text-[11px]" style={{ color: "#9ca3af" }}>
              Secured by Clerk · Data encrypted at rest
            </p>
          </div>
        </div>
      </main>
    </div>
  );
}

// ─── Sub-components ────────────────────────────────────────────────────────────

function SectionHeader({
  eyebrow,
  title,
  subtitle,
}: {
  eyebrow: string;
  title: string;
  subtitle: string;
}) {
  return (
    <div className="mb-8">
      <p className="text-[11px] font-semibold uppercase tracking-[0.12em] mb-2" style={{ color: "#94a3b8" }}>
        {eyebrow}
      </p>
      <h2 className="text-[22px] font-bold tracking-[-0.02em] mb-1.5 leading-tight" style={{ color: "#0f172a" }}>
        {title}
      </h2>
      <p className="text-[14px] leading-relaxed" style={{ color: "#6b7280" }}>
        {subtitle}
      </p>
    </div>
  );
}

function PrimaryButton({ label }: { label: string }) {
  return (
    <button
      type="submit"
      className="w-full flex items-center justify-center gap-2 h-11 rounded-lg font-semibold text-[14px] text-white transition-all duration-200 active:scale-[0.99]"
      style={{ backgroundColor: "#0f172a" }}
      onMouseEnter={(e) => { (e.currentTarget as HTMLElement).style.backgroundColor = "#1e293b"; }}
      onMouseLeave={(e) => { (e.currentTarget as HTMLElement).style.backgroundColor = "#0f172a"; }}
    >
      {label}
      <ArrowRight size={15} strokeWidth={2.5} />
    </button>
  );
}

function BackButton({ onClick, disabled }: { onClick: () => void; disabled?: boolean }) {
  return (
    <button
      type="button"
      onClick={onClick}
      disabled={disabled}
      className="flex items-center justify-center gap-1.5 h-11 px-4 rounded-lg text-[14px] font-medium border transition-all duration-150 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.99]"
      style={{ borderColor: "#d1d5db", color: "#374151", backgroundColor: "#fff" }}
      onMouseEnter={(e) => { (e.currentTarget as HTMLElement).style.backgroundColor = "#f9fafb"; }}
      onMouseLeave={(e) => { (e.currentTarget as HTMLElement).style.backgroundColor = "#fff"; }}
    >
      <ArrowLeft size={14} strokeWidth={2} />
      Back
    </button>
  );
}

function SummaryRow({
  icon,
  label,
  value,
  sub,
}: {
  icon: string;
  label: string;
  value: string;
  sub?: string;
}) {
  return (
    <div className="flex items-start gap-3 px-4 py-3.5">
      <span className="text-[16px] shrink-0 mt-0.5">{icon}</span>
      <div className="flex-1 min-w-0">
        <p className="text-[11px] font-medium uppercase tracking-[0.08em] mb-0.5" style={{ color: "#9ca3af" }}>
          {label}
        </p>
        <p className="text-[13px] font-semibold truncate" style={{ color: "#111827" }}>
          {value}
        </p>
        {sub && (
          <p className="text-[12px] mt-0.5" style={{ color: "#6b7280" }}>
            {sub}
          </p>
        )}
      </div>
    </div>
  );
}
