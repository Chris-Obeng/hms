# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder template, which is meant to be committed.
!.env.example

# agent tooling. Blanket-ignoring .agents and .claude hid edits to the skill
# packs that are committed here, so only the machine-local parts are ignored.
.agents/prompts/
.agents/rules/
.agents/workflows/
.agents/skills/*
!.agents/skills/clerk-nextjs-patterns/
!.agents/skills/clerk-orgs/
!.agents/skills/supabase/
!.agents/skills/supabase-postgres-best-practices/
.claude/settings.local.json

#other dirs
.opencode
.codex
.fallow
.heroui-docs
.kiro

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agents
.env.local
.agents/*
.vercel

# build artifacts / temp
dev-output.log
supabase/.temp/
.tmp/

# heroui-agents-md

# local tool caches (graphify knowledge graph, heroui docs)
graphify-out/
.heroui-docs/
.freebuff/
.commandcode/

# Windows artifacts
nul

# opencode local state
.opencode/

# Playwright session state + screenshots
.playwright/

# session artifacts
/*.log
.claude/worktrees/
.tmp-*

# local design sources (Pencil)
*.pen

# local-only Claude skills & binaries not tracked in skills-lock.json
.claude/skills/impeccable/
.claude/skills/boardui/
.claude/agents/impeccable-*.md

# zcode workspace state & config (contains Supabase MCP access token - never commit)
.zcode/
